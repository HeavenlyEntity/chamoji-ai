{
	"name": "chamoji-workspace",
	"private": true,
	"type": "module",
	"license": "MIT",
	"author": "AMWARE Technologies LLC",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"build": "pnpm -r build",
		"test": "vitest run",
		"check": "pnpm build && tsc -p tsconfig.test.json && oxlint --deny-warnings && oxfmt --check && node scripts/check-docs-site.mjs docs/site",
		"lint": "oxlint",
		"format": "oxfmt",
		"release": "pnpm build && node packages/cli/dist/cli.js release",
		"benchmark": "pnpm build && node scripts/benchmark.mjs",
		"brand:preview": "node scripts/brand-preview.mjs",
		"logo:generate": "node scripts/terminal-logo.mjs",
		"icons:generate": "node scripts/framework-icons.mjs"
	},
	"devDependencies": {
		"@napi-rs/canvas": "^1.1.0",
		"@phosphor-icons/core": "2.1.1",
		"@types/node": "^22.19.0",
		"acorn": "8.19.0",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"remark-mdx": "^3.1.0",
		"remark-parse": "^11.0.0",
		"simple-icons": "16.36.0",
		"typescript": "~6.0.3",
		"unified": "^11.0.5",
		"vitest": "^5.0.5"
	}
}
