{
	"name": "@chamoji/cli",
	"version": "0.5.0",
	"description": "Changelogs from gitmoji and Conventional Commits",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HeavenlyEntity/chamoji-ai.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/HeavenlyEntity/chamoji-ai#readme",
	"bugs": {
		"url": "https://github.com/HeavenlyEntity/chamoji-ai/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"chamoji": "./dist/cli.js"
	},
	"files": [
		"dist",
		"!dist/**/*.map"
	],
	"scripts": {
		"build": "tsc -p .",
		"prepack": "tsc -p . && cp ../../readme.md ../../LICENSE ."
	},
	"dependencies": {
		"@chamoji/core": "workspace:*",
		"@typesafe-ai/sdk": "^0.7.0",
		"meow": "^14.1.0",
		"semver": "^7.8.5"
	},
	"keywords": [
		"changelog",
		"gitmoji",
		"conventional-commits",
		"semver",
		"release",
		"cli"
	],
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/semver": "^7.8.0"
	}
}
