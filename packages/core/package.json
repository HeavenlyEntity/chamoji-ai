{
	"name": "@chamoji/core",
	"version": "0.5.0",
	"description": "Changelog engine for gitmoji and Conventional Commits",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HeavenlyEntity/chamoji-ai.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/HeavenlyEntity/chamoji-ai#readme",
	"bugs": {
		"url": "https://github.com/HeavenlyEntity/chamoji-ai/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.map"
	],
	"scripts": {
		"build": "tsc -p .",
		"prepack": "tsc -p . && cp ../../LICENSE ."
	},
	"dependencies": {
		"gitmojis": "^3.15.0",
		"semver": "^7.7.3"
	},
	"devDependencies": {
		"@types/semver": "^7.7.1"
	},
	"keywords": [
		"changelog",
		"gitmoji",
		"conventional-commits",
		"semver",
		"git"
	],
	"publishConfig": {
		"access": "public"
	}
}
